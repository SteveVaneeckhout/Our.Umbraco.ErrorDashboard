# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4
# Umbraco's own style, and what the existing code uses.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

[*.{ts,js,mjs,cjs,json,jsonc,yml,yaml,css,scss,html,md}]
indent_size = 2

[*.{csproj,props,targets,config,slnx,xml,resx}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ps1,cmd,bat}]
end_of_line = crlf
