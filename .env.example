# Credentials for the umbraco-mcp MCP server (see .mcp.json) and scripts/verify-upgrade.mjs.
# Create an API User in the Umbraco backoffice, open its profile, and copy the client credentials
# here. Copy this file to .env, which is gitignored.
UMBRACO_CLIENT_ID=
UMBRACO_CLIENT_SECRET=
UMBRACO_BASE_URL=https://localhost:44366
