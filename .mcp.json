{
  "mcpServers": {
    "umbraco-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@umbraco-cms/mcp-dev@17.6.8"],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "UMBRACO_INCLUDE_TOOL_COLLECTIONS": "document,media,document-type,data-type,template"
      }
    }
  }
}
